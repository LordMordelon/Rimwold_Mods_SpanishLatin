  <VME_Fire_Despised.comps.0.thoughtStageDescriptions.0>Sin fuegos cerca</VME_Fire_Despised.comps.0.thoughtStageDescriptions.0>
  <!-- EN: Very few fires -->
  <VME_Fire_Despised.comps.0.thoughtStageDescriptions.1>Muy pocos fuegos</VME_Fire_Despised.comps.0.thoughtStageDescriptions.1>
  <!-- EN: Small fire -->
  <VME_Fire_Despised.comps.0.thoughtStageDescriptions.2>Fuego pequeño</VME_Fire_Despised.comps.0.thoughtStageDescriptions.2>
  <!-- EN: Saw fire -->
  <VME_Fire_Despised.comps.0.thoughtStageDescriptions.3>Vi fuego</VME_Fire_Despised.comps.0.thoughtStageDescriptions.3>
  <!-- EN: Blazing fires -->
  <VME_Fire_Despised.comps.0.thoughtStageDescriptions.4>Fuegos ardientes</VME_Fire_Despised.comps.0.thoughtStageDescriptions.4>
