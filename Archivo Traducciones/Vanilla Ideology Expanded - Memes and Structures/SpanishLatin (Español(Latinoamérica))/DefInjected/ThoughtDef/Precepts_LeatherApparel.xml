  <!-- EN: wearing leather clothing -->
  <VME_LeatherApparel_Abhorrent.stages.wearing_leather_clothing.label>usando ropa de cuero</VME_LeatherApparel_Abhorrent.stages.wearing_leather_clothing.label>
