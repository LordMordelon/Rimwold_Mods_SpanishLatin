<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: participated in raid -->
  <VME_ParticipatedInRaid_Abhorrent.stages.participated_in_raid.label>participó en incursión</VME_ParticipatedInRaid_Abhorrent.stages.participated_in_raid.label>
  <!-- EN: I participated in a raid. How could I do that? I'm ashamed. -->
  <VME_ParticipatedInRaid_Abhorrent.stages.participated_in_raid.description>Participé en una incursión. ¿Cómo pude hacer eso? Estoy avergonzado.</VME_ParticipatedInRaid_Abhorrent.stages.participated_in_raid.description>
  
  <!-- EN: participated in raid -->
  <VME_ParticipatedInRaid_Honorable.stages.participated_in_raid.label>participó en incursión</VME_ParticipatedInRaid_Honorable.stages.participated_in_raid.label>
  <!-- EN: I participated in a raid. Through conquest, we bring honor to our colony. -->
  <VME_ParticipatedInRaid_Honorable.stages.participated_in_raid.description>Participé en una incursión. A través de la conquista, traemos honor a nuestra colonia.</VME_ParticipatedInRaid_Honorable.stages.participated_in_raid.description>
  
  <!-- EN: recent conquest -->
  <VME_RecentConquest_Abhorrent.stages.recent_conquest.label>conquista reciente</VME_RecentConquest_Abhorrent.stages.recent_conquest.label>
  <!-- EN: We recently raided another faction. This is horrible and brings shame to our colony. -->
  <VME_RecentConquest_Abhorrent.stages.recent_conquest.description>Recientemente asaltamos otra facción. Esto es horrible y trae vergüenza a nuestra colonia.</VME_RecentConquest_Abhorrent.stages.recent_conquest.description>
  <!-- EN: no recent conquest -->
  <VME_RecentConquest_Abhorrent.stages.no_recent_conquest.label>sin conquista reciente</VME_RecentConquest_Abhorrent.stages.no_recent_conquest.label>
  <!-- EN: It's been a long time since we raided anyone. This is as it should be, we are not bullies. -->
  <VME_RecentConquest_Abhorrent.stages.no_recent_conquest.description>Ha pasado mucho tiempo desde que asaltamos a alguien. Así es como debe ser, no somos matones.</VME_RecentConquest_Abhorrent.stages.no_recent_conquest.description>
  
  <!-- EN: recent conquest -->
  <VME_RecentConquest_Honorable.stages.recent_conquest.label>conquista reciente</VME_RecentConquest_Honorable.stages.recent_conquest.label>
  <!-- EN: We recently raided another faction. Through conquest, we bring honor to our colony. -->
  <VME_RecentConquest_Honorable.stages.recent_conquest.description>Recientemente asaltamos otra facción. A través de la conquista, traemos honor a nuestra colonia.</VME_RecentConquest_Honorable.stages.recent_conquest.description>
  <!-- EN: no recent conquest -->
  <VME_RecentConquest_Honorable.stages.no_recent_conquest.label>sin conquista reciente</VME_RecentConquest_Honorable.stages.no_recent_conquest.label>
  <!-- EN: It's been far too long since we raided anyone, we should attack a settlement soon. -->
  <VME_RecentConquest_Honorable.stages.no_recent_conquest.description>Ha pasado demasiado tiempo desde que asaltamos a alguien, deberíamos atacar un asentamiento pronto.</VME_RecentConquest_Honorable.stages.no_recent_conquest.description>
  
