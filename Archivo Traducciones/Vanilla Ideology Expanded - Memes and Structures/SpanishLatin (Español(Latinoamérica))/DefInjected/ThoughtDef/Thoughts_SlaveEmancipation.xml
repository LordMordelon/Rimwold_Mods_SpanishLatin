<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: amazing slave emancipation -->
  <VME_AmazingSlaveEmancipation.stages.amazing_slave_emancipation.label>emancipación de esclavos asombrosa</VME_AmazingSlaveEmancipation.stages.amazing_slave_emancipation.label>
  <!-- EN: Legends will be told about our leader's speech, and how those words will resonate in the future, elevating the cause of emancipation. -->
  <VME_AmazingSlaveEmancipation.stages.amazing_slave_emancipation.description>Se contarán leyendas sobre el discurso de nuestro líder, y cómo esas palabras resonarán en el futuro, elevando la causa de la emancipación.</VME_AmazingSlaveEmancipation.stages.amazing_slave_emancipation.description>
  
  <!-- EN: demagogic slave emancipation -->
  <VME_DemagogicSlaveEmancipation.stages.demagogic_slave_emancipation.label>emancipación de esclavos demagógica</VME_DemagogicSlaveEmancipation.stages.demagogic_slave_emancipation.label>
  <!-- EN: We ended up looking as the evil guys here... With such a display, it's unlikely anyone will freely want to join the colony. -->
  <VME_DemagogicSlaveEmancipation.stages.demagogic_slave_emancipation.description>Terminamos pareciendo los malos aquí... Con tal exhibición, es poco probable que alguien quiera unirse libremente a la colonia.</VME_DemagogicSlaveEmancipation.stages.demagogic_slave_emancipation.description>
  
  <!-- EN: freethinking slave emancipation -->
  <VME_FreethinkingSlaveEmancipation.stages.freethinking_slave_emancipation.label>emancipación de esclavos librepensadora</VME_FreethinkingSlaveEmancipation.stages.freethinking_slave_emancipation.label>
  <!-- EN: Our leader's speech was clear and succint, explaining all the evils of slavery in a concise way. -->
  <VME_FreethinkingSlaveEmancipation.stages.freethinking_slave_emancipation.description>El discurso de nuestro líder fue claro y sucinto, explicando todos los males de la esclavitud de manera concisa.</VME_FreethinkingSlaveEmancipation.stages.freethinking_slave_emancipation.description>
  
  <!-- EN: liberating slave emancipation -->
  <VME_LiberatingSlaveEmancipation.stages.liberating_slave_emancipation.label>emancipación de esclavos liberadora</VME_LiberatingSlaveEmancipation.stages.liberating_slave_emancipation.label>
  <!-- EN: Our leader's speech was a masterclass in extolling the virtues of a free society, liberated for the shackles of slavery. -->
  <VME_LiberatingSlaveEmancipation.stages.liberating_slave_emancipation.description>El discurso de nuestro líder fue una clase magistral exaltando las virtudes de una sociedad libre, liberada de los grilletes de la esclavitud.</VME_LiberatingSlaveEmancipation.stages.liberating_slave_emancipation.description>
  
  <!-- EN: unshackling slave emancipation -->
  <VME_UnshacklingSlaveEmancipation.stages.unshackling_slave_emancipation.label>emancipación de esclavos desencadenante</VME_UnshacklingSlaveEmancipation.stages.unshackling_slave_emancipation.label>
  <!-- EN: Our leader's speech was very inspiring, detailing all the evils caused by slavery and the immense advantages of a free society. -->
  <VME_UnshacklingSlaveEmancipation.stages.unshackling_slave_emancipation.description>El discurso de nuestro líder fue muy inspirador, detallando todos los males causados por la esclavitud y las inmensas ventajas de una sociedad libre.</VME_UnshacklingSlaveEmancipation.stages.unshackling_slave_emancipation.description>
  
</LanguageData>