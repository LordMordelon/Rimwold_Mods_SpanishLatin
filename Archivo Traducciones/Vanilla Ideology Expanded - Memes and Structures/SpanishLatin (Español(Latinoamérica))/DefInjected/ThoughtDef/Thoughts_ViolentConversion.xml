<LanguageData>
  
  <!-- EN: awkward violent conversion -->
  <VME_AwkwardViolentConversion.stages.awkward_violent_conversion.label>conversión violenta incómoda</VME_AwkwardViolentConversion.stages.awkward_violent_conversion.label>
  <!-- EN: That violent conversion was awkward. The words were vague and unconvincing. -->
  <VME_AwkwardViolentConversion.stages.awkward_violent_conversion.description>Esa conversión violenta fue incómoda. Las palabras fueron vagas y poco convincentes.</VME_AwkwardViolentConversion.stages.awkward_violent_conversion.description>
  
  <!-- EN: satisfying violent conversion -->
  <VME_SatisfyingViolentConversion.stages.satisfying_violent_conversion.label>conversión violenta satisfactoria</VME_SatisfyingViolentConversion.stages.satisfying_violent_conversion.label>
  <!-- EN: That violent conversion was satisfying. The speech was stirring and enjoyable to listen to. -->
  <VME_SatisfyingViolentConversion.stages.satisfying_violent_conversion.description>Esa conversión violenta fue satisfactoria. El discurso fue conmovedor y agradable de escuchar.</VME_SatisfyingViolentConversion.stages.satisfying_violent_conversion.description>
  
  <!-- EN: spectacular violent conversion -->
  <VME_SpectacularViolentConversion.stages.spectacular_violent_conversion.label>conversión violenta espectacular</VME_SpectacularViolentConversion.stages.spectacular_violent_conversion.label>
  <!-- EN: That violent conversion was electrifying! Surely our beliefs will prevail over any others! -->
  <VME_SpectacularViolentConversion.stages.spectacular_violent_conversion.description>¡Esa conversión violenta fue electrizante! ¡Seguramente nuestras creencias prevalecerán sobre cualquier otra!</VME_SpectacularViolentConversion.stages.spectacular_violent_conversion.description>
  
</LanguageData>