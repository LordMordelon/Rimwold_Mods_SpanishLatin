<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: anonymity violated -->
  <VME_NeedAnonymity.stages.anonymity_violated.label>anonimato violado</VME_NeedAnonymity.stages.anonymity_violated.label>
  <!-- EN: They know everything, I’m an open book, entirely vulnerable and without a shred of nuance. -->
  <VME_NeedAnonymity.stages.anonymity_violated.description>Saben todo, soy un libro abierto, completamente vulnerable y sin una pizca de matiz.</VME_NeedAnonymity.stages.anonymity_violated.description>
  <!-- EN: anonymity compromised -->
  <VME_NeedAnonymity.stages.anonymity_compromised.label>anonimato comprometido</VME_NeedAnonymity.stages.anonymity_compromised.label>
  <!-- EN: My identity has been deeply compromised, I’m so ashamed by the attention I’ve garnered for myself. -->
  <VME_NeedAnonymity.stages.anonymity_compromised.description>Mi identidad ha sido profundamente comprometida, estoy tan avergonzado por la atención que he atraído hacia mí.</VME_NeedAnonymity.stages.anonymity_compromised.description>
  <!-- EN: anonymity threatened -->
  <VME_NeedAnonymity.stages.anonymity_threatened.label>anonimato amenazado</VME_NeedAnonymity.stages.anonymity_threatened.label>
  <!-- EN: This can’t be allowed to continue, if I keep this behavior up I’ll be exposed. -->
  <VME_NeedAnonymity.stages.anonymity_threatened.description>Esto no puede continuar, si sigo con este comportamiento seré expuesto.</VME_NeedAnonymity.stages.anonymity_threatened.description>
  <!-- EN: completely anonymous -->
  <VME_NeedAnonymity.stages.completely_anonymous.label>completamente anónimo</VME_NeedAnonymity.stages.completely_anonymous.label>
  <!-- EN: I feel so much more comfortable like this. I don’t even think they know my name or face. -->
  <VME_NeedAnonymity.stages.completely_anonymous.description>Me siento mucho más cómodo así. Ni siquiera creo que sepan mi nombre o mi cara.</VME_NeedAnonymity.stages.completely_anonymous.description>
  
</LanguageData>