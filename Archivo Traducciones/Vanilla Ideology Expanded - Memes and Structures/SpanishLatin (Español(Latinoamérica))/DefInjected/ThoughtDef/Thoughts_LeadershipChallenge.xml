<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: boring leadership challenge -->
  <VME_BoringLeadershipChallenge.stages.boring_leadership_challenge.label>desafío de liderazgo aburrido</VME_BoringLeadershipChallenge.stages.boring_leadership_challenge.label>
  <!-- EN: That leadership challenge was not good. The fighters wouldn't commit, so there were no exciting moments. At least our leader is the strongest. -->
  <VME_BoringLeadershipChallenge.stages.boring_leadership_challenge.description>Ese desafío de liderazgo no fue bueno. Los luchadores no se comprometieron, así que no hubo momentos emocionantes. Al menos nuestro líder es el más fuerte.</VME_BoringLeadershipChallenge.stages.boring_leadership_challenge.description>
  
  <!-- EN: good leadership challenge -->
  <VME_GoodLeadershipChallenge.stages.good_leadership_challenge.label>buen desafío de liderazgo</VME_GoodLeadershipChallenge.stages.good_leadership_challenge.label>
  <!-- EN: A good leadership challenge. The fighters went for blood and showed real heart. We now know that our leader is the strongest. -->
  <VME_GoodLeadershipChallenge.stages.good_leadership_challenge.description>Un buen desafío de liderazgo. Los luchadores fueron por sangre y mostraron verdadero corazón. Ahora sabemos que nuestro líder es el más fuerte.</VME_GoodLeadershipChallenge.stages.good_leadership_challenge.description>
  
  <!-- EN: terrible leadership challenge -->
  <VME_TerribleLeadershipChallenge.stages.terrible_leadership_challenge.label>desafío de liderazgo terrible</VME_TerribleLeadershipChallenge.stages.terrible_leadership_challenge.label>
  <!-- EN: That leadership challenge was terrible. Watching it just made people sad. I guess we have a strong leader, at least... -->
  <VME_TerribleLeadershipChallenge.stages.terrible_leadership_challenge.description>Ese desafío de liderazgo fue terrible. Verlo solo entristeció a la gente. Supongo que tenemos un líder fuerte, al menos...</VME_TerribleLeadershipChallenge.stages.terrible_leadership_challenge.description>
  
  <!-- EN: unforgettable leadership challenge -->
  <VME_UnforgettableLeadershipChallenge.stages.unforgettable_leadership_challenge.label>desafío de liderazgo inolvidable</VME_UnforgettableLeadershipChallenge.stages.unforgettable_leadership_challenge.label>
  <!-- EN: That leadership challenge was unforgettable! Both fighters gave all they had, and we know that our leader is now the strongest among us! -->
  <VME_UnforgettableLeadershipChallenge.stages.unforgettable_leadership_challenge.description>¡Ese desafío de liderazgo fue inolvidable! ¡Ambos luchadores dieron todo lo que tenían, y sabemos que nuestro líder es ahora el más fuerte entre nosotros!</VME_UnforgettableLeadershipChallenge.stages.unforgettable_leadership_challenge.description>
  
</LanguageData>