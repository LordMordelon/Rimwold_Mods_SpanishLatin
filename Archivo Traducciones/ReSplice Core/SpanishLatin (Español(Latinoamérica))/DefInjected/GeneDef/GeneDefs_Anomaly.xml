  <!-- EN: tentacle limbs -->
  <RS_Tentacle_Limbs.label>extremidades de tentáculo</RS_Tentacle_Limbs.label>
  <!-- EN: Carriers of this gene grow tentacle-like appendages instead of one or two of their arms. -->
  <RS_Tentacle_Limbs.description>Los portadores de este gen desarrollan apéndices similares a tentáculos en lugar de uno o dos de sus brazos.</RS_Tentacle_Limbs.description>
  
  <!-- EN: flesh whips limbs -->
  <RS_Tentacle_Whip.label>extremidades de látigo de carne</RS_Tentacle_Whip.label>
  <!-- EN: Carriers of this gene grow tentacle-like appendages with sharp bone-like spikes made from bioferrite instead of one or two of their arms. -->
  <RS_Tentacle_Whip.description>Los portadores de este gen desarrollan apéndices similares a tentáculos con púas afiladas semejantes a huesos hechas de bioferrita en lugar de uno o dos de sus brazos.</RS_Tentacle_Whip.description>
  
  <!-- EN: transmute steel -->
  <RS_TransmuteSteel.label>transmutar acero</RS_TransmuteSteel.label>
  <!-- EN: Carriers can reconfigure steel at the atomic level, turning it into a random valuable material. Can target a stack of steel or a steel slag chunk. -->
  <RS_TransmuteSteel.description>Los portadores pueden reconfigurar el acero a nivel atómico, transformándolo en un material valioso aleatorio. Se puede aplicar sobre una pila de acero o un trozo de escoria de acero.</RS_TransmuteSteel.description>
