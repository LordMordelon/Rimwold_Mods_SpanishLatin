  <!-- EN: responsive -->
  <VWE_ShortStrokePiston.traitAdjectives.4>sensible</VWE_ShortStrokePiston.traitAdjectives.4>
  
  <!-- EN: water-cooled -->
  <VWE_WaterCooled.label>refrigerada por agua</VWE_WaterCooled.label>
  <!-- EN: This weapon is encased in a heavy, liquid-filled cooling jacket. It prevents overheating, allowing for much faster sustained fire, but drastically increases the weapon's weight. -->
  <VWE_WaterCooled.description>Esta arma está encerrada en una pesada camisa de refrigeración llena de líquido. Evita el sobrecalentamiento, permitiendo un fuego sostenido mucho más rápido, pero aumenta drásticamente el peso del arma.</VWE_WaterCooled.description>
