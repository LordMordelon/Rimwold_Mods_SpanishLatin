  <!-- EN: storm -->
  <VWE_SaturationFeed.traitAdjectives.2>tormenta</VWE_SaturationFeed.traitAdjectives.2>
  <!-- EN: flooding -->
  <VWE_SaturationFeed.traitAdjectives.3>inundación</VWE_SaturationFeed.traitAdjectives.3>
  <!-- EN: raining -->
  <VWE_SaturationFeed.traitAdjectives.4>lluvia</VWE_SaturationFeed.traitAdjectives.4>
  
  <!-- EN: short-stroke piston -->
  <VWE_ShortStrokePiston.label>pistón de carrera corta</VWE_ShortStrokePiston.label>
  <!-- EN: This weapon uses a modified short-travel bolt carrier that strictly limits burst length. It fires half as many shots per volley, but the mechanism resets twice as fast, allowing for extremely responsive engagement. -->
  <VWE_ShortStrokePiston.description>Esta arma utiliza un portacerrojo de recorrido corto modificado que limita estrictamente la longitud de la ráfaga. Dispara la mitad de tiros por descarga, pero el mecanismo se reinicia el doble de rápido, lo que permite un enfrentamiento extremadamente sensible.</VWE_ShortStrokePiston.description>
  <!-- EN: short-stroke -->
  <VWE_ShortStrokePiston.traitAdjectives.0>carrera corta</VWE_ShortStrokePiston.traitAdjectives.0>
  <!-- EN: staccato -->
  <VWE_ShortStrokePiston.traitAdjectives.1>staccato</VWE_ShortStrokePiston.traitAdjectives.1>
  <!-- EN: rapid-cycle -->
  <VWE_ShortStrokePiston.traitAdjectives.2>ciclo rápido</VWE_ShortStrokePiston.traitAdjectives.2>
  <!-- EN: skirmish -->
