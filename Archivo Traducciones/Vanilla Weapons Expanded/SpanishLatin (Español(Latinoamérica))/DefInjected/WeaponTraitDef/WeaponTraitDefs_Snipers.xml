<LanguageData>
  
  <!-- EN: acceleration rail -->
  <VWE_AccelerationRail.label>riel de aceleración</VWE_AccelerationRail.label>
  <!-- EN: Retrofitted with a pulse-charge rail system, this weapon fires a single, high-velocity energy bolt that drastically improves damage and armor penetration. -->
  <VWE_AccelerationRail.description>Reequipada con un sistema de riel de carga de pulsos, esta arma dispara un solo perno de energía de alta velocidad que mejora drásticamente el daño y la penetración de armadura.</VWE_AccelerationRail.description>
  <!-- EN: charged -->
  <VWE_AccelerationRail.traitAdjectives.0>cargada</VWE_AccelerationRail.traitAdjectives.0>
  <!-- EN: pulse -->
  <VWE_AccelerationRail.traitAdjectives.1>pulso</VWE_AccelerationRail.traitAdjectives.1>
  <!-- EN: rail-assisted -->
  <VWE_AccelerationRail.traitAdjectives.2>asistida por riel</VWE_AccelerationRail.traitAdjectives.2>
  <!-- EN: retrofitted -->
  <VWE_AccelerationRail.traitAdjectives.3>reequipada</VWE_AccelerationRail.traitAdjectives.3>
  <!-- EN: hybrid -->
  <VWE_AccelerationRail.traitAdjectives.4>híbrida</VWE_AccelerationRail.traitAdjectives.4>
  
  <!-- EN: canted iron sights -->
  <VWE_CantedIronSights.label>miras de hierro inclinadas</VWE_CantedIronSights.label>
  <!-- EN: This weapon includes a secondary sight mounted at a 45-degree angle, allowing the sniper to effectively engage targets at close range without using the scope. -->
  <VWE_CantedIronSights.description>Esta arma incluye una mira secundaria montada en un ángulo de 45 grados, lo que permite al francotirador atacar eficazmente a objetivos a corta distancia sin usar la mira telescópica.</VWE_CantedIronSights.description>
  <!-- EN: canted -->
  <VWE_CantedIronSights.traitAdjectives.0>inclinada</VWE_CantedIronSights.traitAdjectives.0>
  <!-- EN: CQB -->
  <VWE_CantedIronSights.traitAdjectives.1>CQB</VWE_CantedIronSights.traitAdjectives.1>
  <!-- EN: skirmish -->
  <VWE_CantedIronSights.traitAdjectives.2>escaramuza</VWE_CantedIronSights.traitAdjectives.2>
  <!-- EN: hybrid -->
  <VWE_CantedIronSights.traitAdjectives.3>híbrida</VWE_CantedIronSights.traitAdjectives.3>
  <!-- EN: tactical -->
  <VWE_CantedIronSights.traitAdjectives.4>táctica</VWE_CantedIronSights.traitAdjectives.4>
  
  <!-- EN: fixed tele-lens -->
  <VWE_FixedTeleLens.label>teleobjetivo fijo</VWE_FixedTeleLens.label>
  <!-- EN: This weapon is fitted with extreme magnification optics that significantly extend effective range but render the weapon completely unable to target enemies within a large minimum radius. -->
  <VWE_FixedTeleLens.description>Esta arma está equipada con ópticas de aumento extremo que extienden significativamente el alcance efectivo pero hacen que el arma sea completamente incapaz de apuntar a enemigos dentro de un gran radio mínimo.</VWE_FixedTeleLens.description>
  <!-- EN: telescopic -->
  <VWE_FixedTeleLens.traitAdjectives.0>telescópica</VWE_FixedTeleLens.traitAdjectives.0>
  <!-- EN: fixed-zoom -->
  <VWE_FixedTeleLens.traitAdjectives.1>zoom fijo</VWE_FixedTeleLens.traitAdjectives.1>
  <!-- EN: far-sighted -->
  <VWE_FixedTeleLens.traitAdjectives.2>vista lejana</VWE_FixedTeleLens.traitAdjectives.2>
  <!-- EN: observatory -->
  <VWE_FixedTeleLens.traitAdjectives.3>observatorio</VWE_FixedTeleLens.traitAdjectives.3>
  
  <!-- EN: straight-pull action -->
  <VWE_StraightPullAction.label>acción de cerrojo lineal</VWE_StraightPullAction.label>
  <!-- EN: This weapon uses a linear bolt mechanism to drastically reduce cooldown time, though it compromises long-range stability. -->
  <VWE_StraightPullAction.description>Esta arma utiliza un mecanismo de cerrojo lineal para reducir drásticamente el tiempo de enfriamiento, aunque compromete la estabilidad a largo alcance.</VWE_StraightPullAction.description>
  <!-- EN: straight-pull -->
  <VWE_StraightPullAction.traitAdjectives.0>tiro directo</VWE_StraightPullAction.traitAdjectives.0>
  <!-- EN: rapid-bolt -->
  <VWE_StraightPullAction.traitAdjectives.1>cerrojo rápido</VWE_StraightPullAction.traitAdjectives.1>
  <!-- EN: skirmisher -->
  <VWE_StraightPullAction.traitAdjectives.2>escaramuzador</VWE_StraightPullAction.traitAdjectives.2>
  <!-- EN: fast-cycle -->
  <VWE_StraightPullAction.traitAdjectives.3>ciclo rápido</VWE_StraightPullAction.traitAdjectives.3>
  
  <!-- EN: uranium slug -->
  <VWE_UraniumSlug.label>bala de uranio</VWE_UraniumSlug.label>
  <!-- EN: This weapon fires ultra-dense uranium slugs, giving it immense armor-penetrating capabilities, though the heavy recoil increases the time between shots. -->
  <VWE_UraniumSlug.description>Esta arma dispara balas de uranio ultradensas, lo que le otorga inmensas capacidades de penetración de armadura, aunque el fuerte retroceso aumenta el tiempo entre disparos.</VWE_UraniumSlug.description>
