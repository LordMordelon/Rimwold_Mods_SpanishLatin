<LanguageData>
  
  <!-- EN: buntline barrel -->
  <VWE_BuntlineBarrel.label>cañón Buntline</VWE_BuntlineBarrel.label>
  <!-- EN: This weapon features an extended barrel that significantly increases range and accuracy. However, the added weight makes the weapon slower to aim. -->
  <VWE_BuntlineBarrel.description>Esta arma cuenta con un cañón extendido que aumenta significativamente el alcance y la precisión. Sin embargo, el peso añadido hace que el arma sea más lenta para apuntar.</VWE_BuntlineBarrel.description>
  <!-- EN: buntline -->
  <VWE_BuntlineBarrel.traitAdjectives.0>buntline</VWE_BuntlineBarrel.traitAdjectives.0>
  <!-- EN: long-barrel -->
  <VWE_BuntlineBarrel.traitAdjectives.1>cañón largo</VWE_BuntlineBarrel.traitAdjectives.1>
  <!-- EN: carbine -->
  <VWE_BuntlineBarrel.traitAdjectives.2>carabina</VWE_BuntlineBarrel.traitAdjectives.2>
  <!-- EN: extended -->
  <VWE_BuntlineBarrel.traitAdjectives.3>extendida</VWE_BuntlineBarrel.traitAdjectives.3>
  
  <!-- EN: recoil-Op mechanism -->
  <VWE_RecoilOpMechanism.label>mecanismo de retroceso</VWE_RecoilOpMechanism.label>
  <!-- EN: This weapon fires a rapid 3-round burst. The uncontrollable recoil limits the weapon's effective range and severely reduces accuracy at medium and long distances. -->
  <VWE_RecoilOpMechanism.description>Esta arma dispara una ráfaga rápida de 3 rondas. El retroceso incontrolable limita el alcance efectivo del arma y reduce severamente la precisión a distancias medias y largas.</VWE_RecoilOpMechanism.description>
  <!-- EN: automatic -->
  <VWE_RecoilOpMechanism.traitAdjectives.0>automática</VWE_RecoilOpMechanism.traitAdjectives.0>
  <!-- EN: cyclic -->
  <VWE_RecoilOpMechanism.traitAdjectives.1>cíclica</VWE_RecoilOpMechanism.traitAdjectives.1>
  <!-- EN: uncontrollabe -->
  <VWE_RecoilOpMechanism.traitAdjectives.2>incontrolable</VWE_RecoilOpMechanism.traitAdjectives.2>
  <!-- EN: storming -->
  <VWE_RecoilOpMechanism.traitAdjectives.3>tormentosa</VWE_RecoilOpMechanism.traitAdjectives.3>
  <!-- EN: recoil-op -->
  <VWE_RecoilOpMechanism.traitAdjectives.4>op-retroceso</VWE_RecoilOpMechanism.traitAdjectives.4>
  
  <!-- EN: snake-shot loads -->
  <VWE_SnakeShotLoads.label>cargas de perdigones</VWE_SnakeShotLoads.label>
  <!-- EN: This weapon fires spread-shot pellets instead of solid slugs. It provides a major accuracy boost at close range, but deals less damage and has zero armor penetration. -->
  <VWE_SnakeShotLoads.description>Esta arma dispara perdigones dispersos en lugar de balas sólidas. Proporciona un gran aumento de precisión a corta distancia, pero inflige menos daño y tiene cero penetración de armadura.</VWE_SnakeShotLoads.description>
  <!-- EN: snake-shot -->
  <VWE_SnakeShotLoads.traitAdjectives.0>perdigones</VWE_SnakeShotLoads.traitAdjectives.0>
  <!-- EN: pellet -->
  <VWE_SnakeShotLoads.traitAdjectives.1>perdigón</VWE_SnakeShotLoads.traitAdjectives.1>
  <!-- EN: dusting -->
  <VWE_SnakeShotLoads.traitAdjectives.2>polvorear</VWE_SnakeShotLoads.traitAdjectives.2>
  <!-- EN: scattering -->
  <VWE_SnakeShotLoads.traitAdjectives.3>dispersión</VWE_SnakeShotLoads.traitAdjectives.3>
  
  <!-- EN: top-break action -->
  <VWE_TopBreakAction.label>acción basculante</VWE_TopBreakAction.label>
  <!-- EN: This weapon features a hinged frame that breaks open for rapid casing ejection. It reloads significantly faster than a standard model, but the mechanism makes the weapon fragile and prone to breaking. -->
  <VWE_TopBreakAction.description>Esta arma cuenta con un marco con bisagras que se abre para la expulsión rápida de casquillos. Recarga significativamente más rápido que un modelo estándar, pero el mecanismo hace que el arma sea frágil y propensa a romperse.</VWE_TopBreakAction.description>
  <!-- EN: hinged -->
  <VWE_TopBreakAction.traitAdjectives.0>bisagra</VWE_TopBreakAction.traitAdjectives.0>
  <!-- EN: top-break -->
  <VWE_TopBreakAction.traitAdjectives.1>basculante</VWE_TopBreakAction.traitAdjectives.1>
  <!-- EN: snapping -->
  <VWE_TopBreakAction.traitAdjectives.2>chasquido</VWE_TopBreakAction.traitAdjectives.2>
  <!-- EN: fragile -->
  <VWE_TopBreakAction.traitAdjectives.3>frágil</VWE_TopBreakAction.traitAdjectives.3>
  
</LanguageData>