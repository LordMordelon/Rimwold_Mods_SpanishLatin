  <!-- EN: void inscriptions -->
  <VWE_VoidInscriptions.label>inscripciones del vacío</VWE_VoidInscriptions.label>
  <!-- EN: This weapon is etched with shifting, non-euclidean glyphs that whisper to the wielder, continually draining their mental stability while equipped. -->
  <VWE_VoidInscriptions.description>Esta arma está grabada con glifos no euclidianos cambiantes que susurran al portador, drenando continuamente su estabilidad mental mientras está equipada.</VWE_VoidInscriptions.description>
